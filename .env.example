# Dados do app no Portal de Parceiros Nuvemshop (partners.nuvemshop.com.br)
NUVEMSHOP_APP_ID=
NUVEMSHOP_CLIENT_SECRET=
# Nome do app + e-mail de contato (exigido pela API da Nuvemshop)
NUVEMSHOP_USER_AGENT=Compre o Conjunto (seu-email@exemplo.com)

# URL pública do app, sem barra no final (ex.: https://compre-o-conjunto.up.railway.app)
APP_URL=

# Texto longo e aleatório para assinar o login do painel
SESSION_SECRET=

# Login da agência (painel com todas as lojas). Use uma senha forte.
AGENCY_EMAIL=
AGENCY_PASSWORD=

NODE_ENV=production
# Onde salvar o banco (no Railway, aponte para o volume: /data/app.db)
DATABASE_FILE=/data/app.db

# Opcional: tempo de cache dos produtos, em segundos (padrão 120)
# PRODUCT_CACHE_SECONDS=120

# Só para testes locais (NODE_ENV diferente de production): acesse /dev/login
# DEV_STORE_ID=
# DEV_ACCESS_TOKEN=
